{
  "manifest_version": 3,
  "name": "Tab Step",
  "version": "1.1.1",
  "description": "Next / previous tab shortcuts",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-step@dotfiles",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "next-tab": {
      "suggested_key": { "mac": "MacCtrl+J" },
      "description": "Next tab"
    },
    "prev-tab": {
      "suggested_key": { "mac": "MacCtrl+K" },
      "description": "Previous tab"
    }
  }
}
